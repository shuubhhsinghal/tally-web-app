# Keep this file safe to share. Put real values in your shell environment,
# deployment secret store, or a local .env file that is not committed.
GEMINI_API_KEY=replace_with_google_ai_studio_api_key

# Optional settings
GEMINI_MODEL=gemini-3.5-flash-lite
# Set to false to skip the AI fuzzy-match fallback in item-wise purchase
# mapping (exact-match and saved aliases still work either way). Worth
# turning off while your Tally item catalog is still small/empty -- the AI
# step has nothing to match against yet, so it's pure cost with no benefit
# until you've built up a real item list via the app's create-item flow.
ITEM_MATCHING_AI_ENABLED=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
TALLY_URL=http://100.90.163.23:9000

# Meta WhatsApp Webhook Integration
META_VERIFY_TOKEN=replace_with_webhook_verify_token
META_ACCESS_TOKEN=replace_with_system_user_access_token
META_APP_SECRET=replace_with_app_secret
META_API_VERSION=v26.0
