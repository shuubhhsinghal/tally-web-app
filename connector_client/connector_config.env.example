# Copy this file to connector_config.env and fill in the two values below.
# Do not commit connector_config.env anywhere -- CONNECTOR_TOKEN is a secret.

# The backend's WebSocket URL. Use wss:// (not ws://) for the real deployment.
BACKEND_WS_URL=wss://tallybot-api.duckdns.org/ws/connector

# Must exactly match TALLY_CONNECTOR_SECRET set on the backend.
CONNECTOR_TOKEN=replace_with_the_same_secret_the_backend_uses

# Where Tally's HTTP/XML gateway listens on THIS machine. Only change this if
# Tally is configured for a port other than 9000.
TALLY_LOCAL_URL=http://localhost:9000
